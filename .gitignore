# --- Python 관련 ---
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
.env
venv/
env/
.venv/

# --- 데이터베이스 파일 ---
# DB 파일은 서버를 켤 때마다 새로 생성되거나 초기화될 수 있으므로
# 로컬 개발용 파일은 깃에 올리지 않는 것이 좋습니다.
*.db
*.sqlite3

# --- 이미지 및 업로드 폴더 ---
# 실제 서비스에서는 서버에 저장된 이미지를 Git에 올리지 않습니다.
# (파일 크기가 너무 커지고 Git 저장소 용량이 낭비되기 때문입니다.)
profile_images/

# --- IDE 관련 ---
.vscode/
.idea/
.DS_Store

# --- 기타 ---
node_modules/
static/